# PWD301 local development environment template
# Copy to .env and replace secret placeholders locally. Never commit .env.

APP_ENV=development
FLASK_DEBUG=1
HOST=127.0.0.1
PORT=5000

# Secrets — replace with strong random local values.
SECRET_KEY=replace-me-with-a-long-random-secret
JWT_SECRET_KEY=replace-me-with-a-different-long-random-secret

# SQL Server / SQLAlchemy.
# Example uses ODBC Driver 18. Adjust host/database/user locally.
DATABASE_URL=mssql+pyodbc://PWD301_USER:PWD301_PASSWORD@localhost:1433/PWD301?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# File storage
FILE_STORAGE_ROOT=./storage
FILE_QUARANTINE_ROOT=./quarantine
FILE_BACKUP_ROOT=./backups
EXPORT_ROOT=./exports

# Configurable upload limits. Current business rule: video must be strictly < 1 GB.
MAX_IMAGE_BYTES=10000000
MAX_PDF_BYTES=50000000
MAX_DOCX_BYTES=50000000
MAX_PPTX_BYTES=100000000
MAX_VIDEO_BYTES_EXCLUSIVE=1000000000

# Retention / lifecycle
ENROLLMENT_DETAIL_RETENTION_DAYS=30
FILE_RECOVERY_DAYS=30
AI_CHAT_INACTIVITY_SECONDS=300

# Attempt lease — configurable derived default, not a confirmed business constant.
ATTEMPT_LEASE_SECONDS=60
ATTEMPT_HEARTBEAT_SECONDS=10

# Autosave — MCQ saves immediately; text debounce is configurable around 1–2 seconds.
TEXT_AUTOSAVE_DEBOUNCE_MS=1500

# External services. Leave blank until the corresponding implementation phase.
GEMINI_API_KEY=
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# Email transport — configure only when notification/email phase is implemented.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=1

# Logging
LOG_LEVEL=INFO
