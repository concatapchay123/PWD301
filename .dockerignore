# Git
.git
.gitignore

# Virtual Environments
.venv/
venv/
env/

# Python caches and bytecode
__pycache__/
*.py[cod]
*$py.class
*.so

# Testing and linting caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# LLM context bundles and large documentation dumps
PROJECT_CONTEXT_FOR_GEMINI.md
PROJECT_CONTEXT_FOR_GEMINI_AI.md

# Local runtime directories & uploads (persisted via Docker volumes instead)
storage/*
quarantine/*
backups/*
exports/*
instance/*
!instance/.gitkeep

# IDEs & OS artifacts
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Archives & Temporary files
*.bak
*.tmp
*.temp
