id="1139925638" name="Picture 1"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="1139925638" name=""/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId7"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="5943600" cy="3401060"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p w14:paraId="7F1F4511" w14:textId="77777777" w:rsidR="003716A6" w:rsidRPr="003716A6" w:rsidRDefault="003716A6" w:rsidP="003716A6"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:rPr><w:b/><w:bCs/><w:lang w:val="vi-VN"/></w:rPr></w:pPr><w:r><w:rPr><w:lang w:val="vi-VN"/></w:rPr><w:t>Mặc dù giảng viên đã có những thay đổi, chỉnh sửa với các khóa học của mình nhưng khi gửi xét duyệt thì hệ thống lại báo là không có thay đổi và không cho gửi xét duyệt</w:t></w:r></w:p><w:p w14:paraId="6DA997C2" w14:textId="77777777" w:rsidR="003716A6" w:rsidRPr="003716A6" w:rsidRDefault="003716A6" w:rsidP="003716A6"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:rPr><w:b/><w:bCs/><w:lang w:val="vi-VN"/></w:rPr></w:pPr><w:r><w:rPr><w:lang w:val="vi-VN"/></w:rPr><w:t>Cơ chế theo dõi những thay đổi của giảng viên đối với khóa học đang làm rất ngu si đần độn và không thật sự biết được giảng viên đã có những thay đổi gì với các khóa học để hiển thị cho đúng mà bị dulicate thay đổi, có thay đổi nhưng lại hiển thị là không, không nhận diện được thay đổi, không tự cập nhật thay đổi mà bắt buộc phải load lại trang thì mới cập nhật</w:t></w:r></w:p><w:p w14:paraId="662ACC28" w14:textId="46087842" w:rsidR="00DB2668" w:rsidRDefault="003716A6" w:rsidP="003716A6"><w:pPr><w:rPr><w:b/><w:bCs/><w:lang w:val="vi-VN"/></w:rPr></w:pPr><w:r w:rsidRPr="003716A6"><w:rPr><w:b/><w:bCs/><w:lang w:val="vi-VN"/></w:rPr><w:lastRenderedPageBreak/><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="4DFA4D46" wp14:editId="0CA7183D"><wp:extent cx="5943600" cy="3361690"/><wp:effectExtent l="0" t="0" r="0" b="0"/><wp:docPr id="711107444" name="Picture 1"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="711107444" name=""/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId8"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="5943600" cy="3361690"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p w14:paraId="62C01F35" w14:textId="7CCD4E02" w:rsidR="003716A6" w:rsidRDefault="003716A6" w:rsidP="003716A6"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:rPr><w:b/><w:bCs/><w:lang w:val="vi-VN"/></w:rPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/><w:lang w:val="vi-VN"/></w:rPr><w:t>Nút “Xem chi tiết” đã bị xóa mất, khi ấn vào nút đó thì hệ thống sẽ tự động cuộn mượt mà xuống phần “</w:t></w:r><w:r w:rsidRPr="003716A6"><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">Lộ trình đào </w:t></w:r><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>tạo</w:t></w:r><w:r><w:rPr><w:b/><w:bCs/><w:lang w:val="vi-VN"/></w:rPr><w:t>” để học viên có thể xem chi tiết được cấu trúc cây bài học</w:t></w:r></w:p><w:p w14:paraId="2C1D9EBA" w14:textId="750AC8DE" w:rsidR="003716A6" w:rsidRDefault="003716A6" w:rsidP="003716A6"><w:pPr><w:rPr><w:b/><w:bCs/><w:lang w:val="vi-VN"/></w:rPr></w:pPr><w:r w:rsidRPr="003716A6"><w:rPr><w:b/><w:bCs/><w:lang w:val="vi-VN"/></w:rPr><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="39C8E249" wp14:editId="6A9DEB40"><wp:extent cx="5073911" cy="2991004"/><wp:effectExtent l="0" t="0" r="0" b="0"/><wp:docPr id="583889345" name="Picture 1"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="583889345" name=""/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId9"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="5073911" cy="2991004"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p w14:paraId="6B56D30C" w14:textId="3E7C6925" w:rsidR="003716A6" w:rsidRPr="003716A6" w:rsidRDefault="003716A6" w:rsidP="003716A6"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:rPr><w:b/><w:bCs/><w:lang w:val="vi-VN"/></w:rPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/><w:lang w:val="vi-VN"/></w:rPr><w:t xml:space="preserve">Phần giao diện của bài kiểm tra. Ở trên UI “Điểm” thì lại hiển thị học sinh có điểm là 5/10 nhưng ở dưới cột “Điểm số” thì lại ghi là “Chờ công bố”. Đây là lỗi bất đồng bộ, cần khắc phục triệt để lỗi </w:t></w:r><w:r w:rsidR="008C5F2E"><w:rPr><w:b/><w:bCs/><w:lang w:val="vi-VN"/></w:rPr><w:t xml:space="preserve">này. UI “Điểm” thì sẽ hiển thị điểm theo </w:t></w:r><w:r w:rsidR="008C5F2E"><w:rPr><w:b/><w:bCs/><w:lang w:val="vi-VN"/></w:rPr><w:lastRenderedPageBreak/><w:t>cấu hình của giảng viên (lấy điểm cao nhất, điểm lần thi mới nhất, lần thi đầu tiên,...) còn cột “Điểm số” là sẽ hiển thị điểm chính xác của bài thi đó</w:t></w:r></w:p><w:sectPr w:rsidR="003716A6" w:rsidRPr="003716A6" w:rsidSect="003716A6"><w:pgSz w:w="12240" w:h="15840"/><w:pgMar w:top="1440" w:right="1440" w:bottom="1440" w:left="1440" w:header="720" w:footer="720" w:gutter="0"/><w:cols w:space="720"/><w:docGrid w:linePitch="360"/></w:sectPr></w:body></w:document>